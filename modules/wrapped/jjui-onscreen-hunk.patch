new file mode 100644
index 0000000..f7421b3
--- /dev/null
+++ b/internal/ui/diff/edit_target_test.go
@@ -0,0 +1,121 @@
+package diff
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/idursun/jjui/internal/jj"
+	"github.com/idursun/jjui/internal/ui/intents"
+	"github.com/idursun/jjui/internal/ui/layout"
+	"github.com/idursun/jjui/internal/ui/render"
+	"github.com/idursun/jjui/test"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRefreshKeepsComparisonFileAndScroll(t *testing.T) {
+	runner := test.NewTestCommandRunner(t)
+	args := []string{"diff", "--from", "base", "--to", "selected"}
+	file := jj.NewFileName("with spaces.txt")
+	runner.Expect(append(append([]string(nil), args...), file.Escaped())).SetOutput([]byte("updated\ncontent\nmore lines"))
+	runner.Expect(append(append([]string(nil), args...), "--summary")).SetOutput([]byte("M with spaces.txt"))
+	defer runner.Verify()
+	m := NewWithContext(test.NewTestContext(runner), "old\ncontent", args)
+	m.currentFile = file
+	m.scrollY = 1
+	m.cursorY = 1
+	m.viewportWidth, m.viewportHeight = 40, 2
+	test.SimulateModel(m, m.Update(intents.DiffRefresh{}))
+	require.Equal(t, args, m.originalArgs)
+	require.Equal(t, file, m.currentFile)
+	require.Equal(t, 1, m.scrollY)
+	require.Equal(t, 1, m.cursorY)
+	require.Equal(t, "updated", m.lines[0])
+}
+
+func TestEditTargetNumberedDiff(t *testing.T) {
+	content := "Modified regular file first.txt:\n   1    1: context\n   2     : old\n        2: new\n    ...\n  50   50: later hunk\nModified regular file name with spaces.txt:\n   7    8: next file"
+	for _, tc := range []struct {
+		top  int
+		file string
+		line int
+	}{
+		{0, "first.txt", 1}, {2, "first.txt", 2}, {4, "first.txt", 50},
+		{5, "first.txt", 50}, {6, "name with spaces.txt", 8}, {7, "name with spaces.txt", 8},
+	} {
+		m := New(content)
+		m.targetFiles = []jj.FileName{jj.NewFileName("first.txt"), jj.NewFileName("name with spaces.txt")}
+		m.cursorY = tc.top
+		file, line, ok := m.editTarget()
+		require.True(t, ok)
+		require.Equal(t, tc.file, file.Path())
+		require.Equal(t, tc.line, line)
+	}
+}
+
+func TestEditTargetWrapAndColors(t *testing.T) {
+	m := New("\x1b[32mModified regular file f.txt:\x1b[0m\n   1    1: " + strings.Repeat("x", 60) + "\n   9   10: next")
+	m.targetFiles = []jj.FileName{jj.NewFileName("f.txt")}
+	m.mode = newWrappedView(m.lines)
+	m.viewportWidth = 20
+	m.cursorY = 3 // inside the wrapped first source line
+	file, line, ok := m.editTarget()
+	require.True(t, ok)
+	require.Equal(t, "f.txt", file.Path())
+	require.Equal(t, 1, line)
+}
+
+func TestEditTargetRejectsNonTextAndStaticDiffs(t *testing.T) {
+	m := New("Modified regular file f.txt:\n   1    1: text\nModified regular file binary.dat:\n(binary)")
+	m.targetFiles = []jj.FileName{jj.NewFileName("f.txt"), jj.NewFileName("binary.dat")}
+	m.cursorY = 3
+	_, _, ok := m.editTarget()
+	require.False(t, ok)
+	_, ok = m.QueryState("target_revision")
+	require.False(t, ok)
+	m.originalArgs = []string{"op", "show", "test"}
+	_, ok = m.QueryState("target_revision")
+	require.False(t, ok)
+	m.originalArgs = []string{"diff", "--from", "old", "--to", "new"}
+	value, ok := m.QueryState("target_revision")
+	require.True(t, ok)
+	require.Equal(t, "new", value)
+}
+
+func TestCursorNavigationKeepsSelectionVisible(t *testing.T) {
+	m := New("0\n1\n2\n3\n4")
+	m.viewportWidth, m.viewportHeight = 20, 3
+	for range 2 {
+		m.Update(intents.DiffScroll{Kind: intents.DiffScrollDown})
+	}
+	require.Equal(t, 2, m.cursorY)
+	require.Equal(t, 0, m.scrollY)
+	m.Update(intents.DiffScroll{Kind: intents.DiffScrollDown})
+	require.Equal(t, 3, m.cursorY)
+	require.Equal(t, 1, m.scrollY)
+	m.Update(intents.DiffScroll{Kind: intents.DiffMoveBottom})
+	require.Equal(t, 4, m.cursorY)
+	require.Equal(t, 2, m.scrollY)
+	m.Update(intents.DiffScroll{Kind: intents.DiffMoveTop})
+	require.Zero(t, m.cursorY)
+	require.Zero(t, m.scrollY)
+}
+
+func TestCursorTargetsSelectedLineWithinViewport(t *testing.T) {
+	m := New("Modified regular file f.txt:\n   1    1: first\n  80   80: second")
+	m.targetFiles = []jj.FileName{jj.NewFileName("f.txt")}
+	m.viewportWidth, m.viewportHeight = 40, 10
+	m.Update(intents.DiffScroll{Kind: intents.DiffScrollDown})
+	m.Update(intents.DiffScroll{Kind: intents.DiffScrollDown})
+	_, line, ok := m.editTarget()
+	require.True(t, ok)
+	require.Equal(t, 80, line)
+	require.Zero(t, m.scrollY)
+}
+
+func TestSelectedLineDoesNotShowTerminalCursor(t *testing.T) {
+	m := New("first\nsecond\nthird")
+	m.cursorY = 1
+	dl := render.NewDisplayContext()
+	m.ViewRect(dl, layout.NewBox(layout.Rect(4, 5, 20, 3)))
+	require.Nil(t, dl.Cursor())
+}
