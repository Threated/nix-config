diff --git a/internal/ui/diff/edit_target.go b/internal/ui/diff/edit_target.go
new file mode 100644
index 0000000..0e5aeb0
--- /dev/null
+++ b/internal/ui/diff/edit_target.go
@@ -0,0 +1,127 @@
+package diff
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/idursun/jjui/internal/jj"
+)
+
+type refreshLoadedMsg struct {
+	content string
+	args    []string
+	file    jj.FileName
+	scroll  int
+	cursor  int
+	err     error
+}
+
+// Reload the same comparison and file without resetting the viewport.
+func (m *Model) refreshContent() tea.Cmd {
+	if m.context == nil || len(m.originalArgs) == 0 {
+		return nil
+	}
+	originalArgs := append([]string(nil), m.originalArgs...)
+	args := append([]string(nil), originalArgs...)
+	file, scroll, cursor := m.currentFile, m.scrollY, m.cursorY
+	if !file.IsEmpty() {
+		args = append(args, file.Escaped())
+	}
+	return func() tea.Msg {
+		output, err := m.context.RunCommandImmediate(args)
+		return refreshLoadedMsg{content: string(output), args: originalArgs, file: file, scroll: scroll, cursor: cursor, err: err}
+	}
+}
+
+var numberedDiffRow = regexp.MustCompile(`^\s*([0-9]*)\s+([0-9]*)\s*:`)
+
+// QueryState exposes the file and modified-side line selected by the cursor.
+// Unsupported formatters, binary diffs, and static/operation diffs have no target.
+func (m *Model) QueryState(name string) (any, bool) {
+	revision := m.editRevision()
+	if revision == "" {
+		return nil, false
+	}
+	if name == "target_revision" {
+		return revision, true
+	}
+	file, line, ok := m.editTarget()
+	if !ok {
+		return nil, false
+	}
+	switch name {
+	case "target_file":
+		return file.Escaped(), true
+	case "target_line":
+		return line, true
+	}
+	return nil, false
+}
+
+func (m *Model) editRevision() string {
+	if len(m.originalArgs) == 0 || m.originalArgs[0] != "diff" {
+		return ""
+	}
+	for i, arg := range m.originalArgs {
+		if (arg == "-r" || arg == "--revision" || arg == "--to" || arg == "-t") && i+1 < len(m.originalArgs) {
+			return m.originalArgs[i+1]
+		}
+	}
+	return ""
+}
+
+func (m *Model) editTarget() (jj.FileName, int, bool) {
+	selected := m.cursorY
+	if wrapped, ok := m.mode.(*wrappedView); ok {
+		selected, _ = wrapped.firstLine(selected, max(1, m.viewportWidth))
+	}
+	var file jj.FileName
+	lastRight := 0
+	for index, styled := range m.lines {
+		line := ansi.Strip(styled)
+		if header, ok := m.editHeader(line); ok {
+			// Do not cross into another file when seeking from a header or gap.
+			if index > selected && header != file {
+				break
+			}
+			file = header
+			lastRight = 0
+			continue
+		}
+		if file.IsEmpty() {
+			continue
+		}
+		right := 0
+		if matches := numberedDiffRow.FindStringSubmatch(line); matches != nil && (matches[1] != "" || matches[2] != "") {
+			right, _ = strconv.Atoi(matches[2])
+			if matches[2] == "" {
+				right = lastRight + 1
+			} else {
+				lastRight = right
+			}
+		}
+		if index >= selected && right > 0 {
+			return file, right, true
+		}
+	}
+	return jj.FileName{}, 0, false
+}
+
+func (m *Model) editHeader(line string) (jj.FileName, bool) {
+	defaultHeader := false
+	for _, verb := range []string{"Modified ", "Added ", "Removed ", "Renamed ", "Copied "} {
+		defaultHeader = defaultHeader || (strings.HasPrefix(line, verb) && strings.Contains(line, " file "))
+	}
+	var match jj.FileName
+	for _, file := range m.targetFiles {
+		if defaultHeader && strings.HasSuffix(line, " "+file.Path()+":") {
+			if len(file.Path()) > len(match.Path()) {
+				match = file
+			}
+		}
+	}
+	return match, !match.IsEmpty()
+}
