{
  "tagOwners": {
    "tag:ci": ["Threated@"],
    "tag:rpi": ["Threated@"]
  },
  "grants": [
    {
      "src": ["Threated@"],
      "dst": ["*"],
      "ip": ["*"]
    },
    {
      "src": ["autogroup:member"],
      "dst": ["*"],
      "ip": ["*"]
    },
    {
      "src": ["tag:ci"],
      "dst": ["tag:rpi"],
      "ip": ["tcp:22"]
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": ["tag:ci"],
      "dst": ["tag:rpi"],
      "users": ["rpi-ci"]
    },
    {
      "action": "accept",
      "src": ["Threated@"],
      "dst": ["autogroup:member", "autogroup:tagged"],
      "users": ["root", "autogroup:nonroot"]
    }
  ]
}
